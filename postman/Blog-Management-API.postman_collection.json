{
  "info": {
    "name": "Blog Management API",
    "description": "CRUD for posts, categories, and comments. Run the requests in order; create requests save IDs for subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('categoryId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Technology\",\"description\":\"Technology articles\"}"
            },
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "Get category",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories/{{categoryId}}"
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Technology\",\"description\":\"Updated description\"}"
            },
            "url": "{{baseUrl}}/api/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('postId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Hello blog\",\"content\":\"My first post\",\"author\":\"Alex\",\"categoryIds\":[{{categoryId}}]}"
            },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "List posts (pagination, sort, filters)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/posts?page=0&size=10&sort=createdAt,desc&categoryId={{categoryId}}&author=Alex"
          }
        },
        {
          "name": "Get post",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "Update post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Updated post\",\"content\":\"Updated body\",\"author\":\"Alex\",\"categoryIds\":[{{categoryId}}]}"
            },
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('commentId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Thanks for sharing\",\"author\":\"Sam\"}"
            },
            "url": "{{baseUrl}}/api/posts/{{postId}}/comments"
          }
        },
        {
          "name": "List comments for post",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/posts/{{postId}}/comments?page=0&size=10&sort=createdAt,desc"
          }
        },
        {
          "name": "Get comment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/comments/{{commentId}}"
          }
        },
        {
          "name": "Update comment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Updated comment\",\"author\":\"Sam\"}"
            },
            "url": "{{baseUrl}}/api/comments/{{commentId}}"
          }
        },
        {
          "name": "Approve comment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"approved\":true}"
            },
            "url": "{{baseUrl}}/api/comments/{{commentId}}/moderation"
          }
        },
        {
          "name": "Delete comment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/categories/{{categoryId}}"
          }
        }
      ]
    }
  ]
}
